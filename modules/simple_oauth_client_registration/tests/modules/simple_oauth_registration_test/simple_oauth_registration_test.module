<?php

/**
 * @file
 * Provides guarded persistence failures for registration rollback tests.
 */

declare(strict_types=1);

use Drupal\consumers\Entity\ConsumerInterface;
use Drupal\Core\Entity\EntityStorageException;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityTypeInterface;

/**
 * Implements hook_entity_base_field_info_alter().
 */
function simple_oauth_registration_test_entity_base_field_info_alter(array &$fields, EntityTypeInterface $entity_type): void {
  // Model the consumer schema in supported Simple OAuth versions before 6.0.6.
  if ($entity_type->id() === 'consumer' && \Drupal::state()->get('simple_oauth_registration_test.legacy_scope_field', FALSE)) {
    unset($fields['authorization_code_scopes']);
  }
}

/**
 * Implements hook_ENTITY_TYPE_update().
 *
 * Throws after the entity write to exercise transaction rollback.
 */
function simple_oauth_registration_test_consumer_update(ConsumerInterface $consumer): void {
  if (\Drupal::state()->get('simple_oauth_registration_test.fail_update', FALSE)) {
    throw new EntityStorageException('Registration fixture persistence failure');
  }
}

/**
 * Implements hook_entity_delete().
 *
 * Fails after consumer deletion and native policy cleanup have run.
 */
function simple_oauth_registration_test_entity_delete(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() === 'consumer' && (string) $entity->id() === (string) \Drupal::state()->get('simple_oauth_registration_test.fail_delete_id', '')) {
    throw new EntityStorageException('Registration fixture deletion failure');
  }
}

/**
 * Implements hook_entity_insert().
 */
function simple_oauth_registration_test_entity_insert(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() === 'consumer' && \Drupal::state()->get('simple_oauth_registration_test.fail_insert', FALSE)) {
    throw new EntityStorageException('Registration fixture insertion failure');
  }
}
