<?php

/**
 * @file
 * Simple OAuth Server Metadata module.
 */

declare(strict_types=1);

use Drupal\Core\Cache\Cache;

/**
 * Implements hook_modules_installed().
 */
function simple_oauth_server_metadata_modules_installed($modules, $is_syncing): void {
  // Installed modules can add endpoints, scope definitions and grant plugins.
  Cache::invalidateTags([
    'simple_oauth_server_metadata',
    'oauth2_grant_plugins',
    'route_match',
  ]);
}

/**
 * Implements hook_modules_uninstalled().
 */
function simple_oauth_server_metadata_modules_uninstalled($modules, $is_syncing): void {
  Cache::invalidateTags([
    'simple_oauth_server_metadata',
    'oauth2_grant_plugins',
    'route_match',
  ]);
}
