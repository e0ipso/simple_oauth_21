{
  "name": "e0ipso/simple_oauth_21",
  "description": "Implements OAuth 2.1 on top of Simple OAuth for Drupal",
  "type": "drupal-module",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Mateu Aguiló Bosch",
      "email": "mateu@mateuaguilo.com"
    }
  ],
  "provide": {
    "drupal/simple_oauth_client_registration": "self.version",
    "drupal/simple_oauth_device_flow": "self.version",
    "drupal/simple_oauth_native_apps": "self.version",
    "drupal/simple_oauth_pkce": "self.version",
    "drupal/simple_oauth_server_metadata": "self.version"
  },
  "require": {
    "drupal/simple_oauth": ">=6.1.4 <7.0"
  },
  "require-dev": {
    "drupal/coder": "^8",
    "phpstan/phpstan": "^2.1",
    "mglaman/phpstan-drupal": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/extension-installer": "^1.4"
  },
  "scripts": {
    "syntax:check": "find . -type f \\( -name '*.php' -o -name '*.module' -o -name '*.install' \\) ! -path './vendor/*' ! -path './node_modules/*' -exec sh -c 'status=0; for file do php -l \"$file\" || status=1; done; exit \"$status\"' sh {} +",
    "lint:check": [
      "@syntax:check",
      "php ./vendor/bin/phpcs --ignore=vendor/*,node_modules/* --standard=Drupal,DrupalPractice --extensions=php,module/php,install/php,inc/php,yml ."
    ],
    "lint:fix": "php ./vendor/bin/phpcbf --ignore=vendor/*,node_modules/* --standard=Drupal,DrupalPractice --extensions=php,module/php,install/php,inc/php,yml .",
    "release": "npm run semantic-release"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
